# PBC+ Studio: cross-origin isolation for the worker emulator.
# With these two headers the browser provides SharedArrayBuffer, and
# PBC+ Studio runs programs in a Web Worker (real sleep/input, Stop
# works for every program). Without them, PBC+ Studio still works and
# uses its older emulator.
# "require-corp", not "credentialless": Safari (and so every browser on
# iPad and iPhone) does not know "credentialless" and would not isolate
# the page. All external files come from cdnjs/jsdelivr, which send
# "Cross-Origin-Resource-Policy: cross-origin"; Blockly's icons and
# sounds come from jsdelivr (option "media" in 60_arbeitsflaeche.js).
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>

# The page embeds MicroPython; compressed it is about half the size.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
</IfModule>
