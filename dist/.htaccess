# PBC+ Studio: always https, always without "www".
# The USB connection (Web Serial) and the emulator (SharedArrayBuffer)
# exist only in a secure context; over plain http neither works.
# A request counts as https if ANY of the three signs says so, so that
# a server which reports it differently cannot end in a redirect loop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# PBC+ Studio: cross-origin isolation for the worker emulator.
# With these two headers the browser provides SharedArrayBuffer, and
# PBC+ Studio runs programs in a Web Worker (real sleep/input, Stop
# works for every program). Without them the emulator does not run and
# says so; blocks, editor and the PBC+ via USB still work.
# "require-corp", not "credentialless": Safari (and so every browser on
# iPad and iPhone) does not know "credentialless" and would not isolate
# the page. All external files come from cdnjs/jsdelivr, which send
# "Cross-Origin-Resource-Policy: cross-origin"; Blockly's icons and
# sounds come from jsdelivr (option "media" in 60_arbeitsflaeche.js).
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>

# The page embeds MicroPython; compressed it is about half the size.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
</IfModule>
